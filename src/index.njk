---
layout: base.njk
---
<figure class="banner wrap">
  <img src="/images/workbench.webp" alt="My desk at night: a laptop with code open, a multimeter, breadboards, jumper wires, and parts bins under a desk lamp" width="2400" height="533">
</figure>

<section class="intro wrap" aria-labelledby="intro-h">
  <p class="spec"><span>Oregon State University</span><span>Engineering</span></p>
  <h1 id="intro-h">Where Blake Henderson builds things and documents it</h1>
</section>

<section id="projects" class="projects wrap" aria-labelledby="projects-h">
  <h2 id="projects-h" class="label"><span class="label__no">01</span> Projects</h2>
  <link rel="stylesheet" href="/css/grid.css">
  <ol class="pgrid">
    {% for p in collections.projects %}
    <li>
      <a href="{{ p.url }}">
        {% set card = p.data.cardImage or p.data.cover %}{% if card %}<img src="{{ card }}" alt="" width="1600" height="1200" loading="lazy">{% else %}<div class="pgrid__none">No photo yet</div>{% endif %}
        <h3>{{ p.data.title }}</h3>
        <p class="pgrid__meta">{{ p.date | monthYear }}{% if p.data.wip %} <span class="pgrid__wip">Work in progress</span>{% endif %}</p>
      </a>
    </li>
    {% endfor %}
  </ol>
</section>

<section id="about" class="about wrap" aria-labelledby="about-h">
  <h2 id="about-h" class="label"><span class="label__no">02</span> About</h2>
  <div class="about__body">
    <img class="about__photo" src="/images/blake.webp" alt="Blake Henderson" width="480" height="480" loading="lazy">
    <p class="about__text">{{ site.about }}</p>
  </div>
</section>

<section id="contact" class="contact wrap" aria-labelledby="contact-h">
  <h2 id="contact-h" class="label"><span class="label__no">03</span> Contact</h2>
  <dl class="contact__list">
    <div><dt>Email</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% if site.emailIsPlaceholder %} <span class="ph">[PLACEHOLDER]</span>{% endif %}</dd></div>
    <div><dt>GitHub</dt><dd><a href="{{ site.github }}">{{ site.github | replace("https://", "") }}</a></dd></div>
    <div><dt>LinkedIn</dt><dd><a href="{{ site.linkedin }}">{{ site.linkedin | replace("https://www.", "") }}</a></dd></div>
  </dl>
</section>
{% include "lightbox.njk" %}
