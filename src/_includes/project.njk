---
layout: base.njk
---
{%- set idx = 0 -%}
{%- for p in collections.projects -%}{%- if p.url == page.url -%}{%- set idx = loop.index -%}{%- endif -%}{%- endfor -%}
<article class="project wrap">
  <header class="project__head">
    <p class="spec"><span>BH-{{ idx | pad }}</span><span>{{ page.date | monthYear }}</span>{% for t in tags %}{% if t != "projects" %}<span>{{ t }}</span>{% endif %}{% endfor %}</p>
    <h1>{{ title }}</h1>{% if wip %}<p style="margin:.5rem 0 0"><span class="wip" style="display:inline-block;vertical-align:middle;padding:.1rem .4rem;border:1px solid #d9480f;color:#d9480f;font-family:var(--mono,monospace);font-size:.7rem;letter-spacing:.04em;text-transform:uppercase;line-height:1.4;white-space:nowrap">Work in progress</span></p>{% endif %}
    <p class="lede">{{ summary }}</p>
    {% if repo %}<p class="spec project__repo"><a href="{{ repo }}">View code on GitHub →</a></p>{% endif %}
  </header>
  {% if video %}
  <figure class="project__video">
    {% set src = video %}{% set poster = cover %}{% set label = title + " demo video" %}{% include "media.njk" %}
  </figure>
  {% elif cover and not hideCover and not introFirst %}
  <figure class="project__cover">
    <img src="{{ cover }}" alt="{{ title }} — cover photo" width="1600" height="1000">
    {% if coverCaption %}<figcaption>{{ coverCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <nav class="project__back" aria-label="Project navigation"><a href="/#projects">← All projects</a></nav>
</article>
<link rel="stylesheet" href="/css/project-wide.css">
{% include "lightbox.njk" %}
